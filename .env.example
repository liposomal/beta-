# Secrets d'hébergement. Les IDs Discord sont configurés avec !configurer.
SENTINELLE_TOKEN=
# Secret OAuth2 de la MEME application que le bot Sentinelle.
OAUTH2_CLIENT_SECRET=
# Enregistrer exactement cette URL dans le portail développeur Discord.
OAUTH2_REDIRECT_URI=https://votre-domaine.example/callback
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Conserver cette clé : sa perte rend les jetons stockés illisibles.
TOKEN_ENCRYPTION_KEY=
# Exposer via un reverse proxy HTTPS ; ne pas exposer Supabase service_role au navigateur.
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
RATE_LIMIT_DELAY=0.25
EVACUATION_CONCURRENCY=3
